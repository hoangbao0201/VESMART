# Local app on same host as Postgres:
# DATABASE_URL=postgresql://vesmart:CHANGE_ME@localhost:5432/vesmart_db?schema=public
# Remote app → VPS Postgres:
DATABASE_URL=postgresql://vesmart:CHANGE_ME@139.180.136.119:5432/vesmart_db?schema=public
# Optional: legacy Mongo (migrate-from-mongo script only)
SOURCE_MONGODB_URL=
JWT_SECRET=change-me-access
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=365d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare R2 (S3-compatible). Endpoint = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL (custom domain / r2.dev), no trailing slash — returned as `${R2_PUBLIC_URL}/${key}`
# Example: https://cdn.vesmart.vn
R2_PUBLIC_URL=
CORS_ORIGIN=http://localhost:3000
PORT=3001
# Forum Auto: cookie Facebook (c_user + xs). Copy từ Chrome Network → facebook.com
FB_COOKIE=
# Optional override path to auto-post-forum (default: ../auto-post-forum from be/)
AUTO_POST_FORUM_DIR=
